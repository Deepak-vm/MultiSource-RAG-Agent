# === Gemini API Key (Required for FAISS vector embeddings) ===
# Get a free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# === Groq API Key (Required for LLM routing and synthesis) ===
# Get a free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# === LangSmith Tracing (Optional — set false to disable) ===
# Get a free key at: https://smith.langchain.com
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_key_here
LANGCHAIN_PROJECT=multi-source-rag
